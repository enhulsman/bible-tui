---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="parchment-texture" aria-hidden="true"></div>

  <!-- Header -->
  <header class="px-6 py-4 md:px-12 md:py-6">
    <span class="wordmark">bible.arc8.dev</span>
  </header>

  <!-- Hero section -->
  <section class="hero-section px-6 pb-32">
    <div class="mx-auto max-w-[720px] text-center">
      <h1 class="verse-heading">
        "In the beginning was the Word, and the Word was with God, and the Word was God."
      </h1>
      <p class="verse-ref">— John 1:1, KJV</p>
      <div class="divider"></div>
      <p class="subtitle">
        A terminal Bible reader in your browser. Three translations, vim navigation, full-text search.
      </p>
    </div>
  </section>

  <!-- Transition + Terminal section -->
  <div class="transition-wrapper">
    <div class="lightbeam-backdrop" aria-hidden="true"></div>
    <div class="mx-auto max-w-[900px] px-6">
      <!-- Terminal container -->
      <div class="terminal-container">
        <!-- Title bar -->
        <div class="terminal-titlebar">
          <div class="flex items-center gap-1.5">
            <span class="traffic-dot"></span>
            <span class="traffic-dot"></span>
            <span class="traffic-dot"></span>
          </div>
          <span class="terminal-name">bible-tui</span>
        </div>
        <!-- Terminal body -->
        <div class="terminal-body">
          <div class="flex flex-col items-center gap-2">
            <span class="terminal-loading">Loading Bible reader...</span>
            <span class="cursor-block" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <!-- Keyboard hints -->
      <div class="kbd-hints">
        <span>j/k scroll</span>
        <span class="kbd-sep">·</span>
        <span>/ search</span>
        <span class="kbd-sep">·</span>
        <span>g go to</span>
        <span class="kbd-sep">·</span>
        <span>b bookmarks</span>
        <span class="kbd-sep">·</span>
        <span>? help</span>
      </div>
    </div>

    <!-- About section -->
    <section class="about-section">
      <div class="mx-auto max-w-[560px] px-6 text-center">
        <p class="about-text">
          Built with Rust and compiled to WebAssembly. Three translations: KJV, WEB, and Dutch Statenvertaling.
          All processing happens in your browser — no server, no tracking.
        </p>
        <a
          href="https://github.com/Arc891/bible-tui"
          class="source-link"
          target="_blank"
          rel="noopener noreferrer"
        >View source on GitHub</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <span>Part of the arc8.dev network</span>
      <span class="footer-sep">·</span>
      <a
        href="https://hulsman.dev"
        class="footer-link"
        target="_blank"
        rel="noopener noreferrer"
      >hulsman.dev</a>
    </footer>
  </div>
</Layout>

<style>
  /* Parchment texture overlay — fixed, behind all hero content */
  .parchment-texture {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    background-image: url('/assets/parchment.webp');
    background-size: 512px 512px;
    background-repeat: repeat;
    opacity: 0.5;
    mix-blend-mode: multiply;
    mask-image: linear-gradient(to bottom, black 0%, black 25%, transparent 55%);
  }

  /* Wordmark */
  .wordmark {
    font-family: var(--font-sans);
    font-size: 14px;
    color: color-mix(in srgb, #2C2825 50%, transparent);
    letter-spacing: 0.01em;
  }

  /* Hero */
  header {
    position: relative;
    z-index: 1;
  }

  .hero-section {
    padding-top: 20vh;
    position: relative;
    z-index: 1;
  }

  .verse-heading {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #2C2825;
  }

  .verse-ref {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: color-mix(in srgb, #2C2825 40%, transparent);
    margin-top: 1.5rem;
  }

  .divider {
    width: 80px;
    height: 1px;
    background: #8B4049;
    margin: 3rem auto 0;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.125rem;
    color: color-mix(in srgb, #2C2825 70%, transparent);
    max-width: 480px;
    margin: 2rem auto 0;
    text-align: center;
    line-height: 1.6;
  }

  /* Transition wrapper — parchment fades to dark */
  .transition-wrapper {
    background-image:
      linear-gradient(to bottom,
        rgba(245,242,235,0.95) 0%,
        rgba(237,233,224,0.97) 2%,
        rgba(221,214,200,0.98) 6%,
        rgba(184,173,153,0.99) 12%,
        rgba(154,142,122,1) 18%,
        #7D7163 24%,
        #5E5345 30%,
        #3F3630 36%,
        #2A2420 42%,
        #1A1816 50%,
        #1A1816 100%
      ),
      url('/assets/parchment.webp');
    background-size: auto, 512px 512px;
    background-repeat: no-repeat, repeat;
    background-attachment: scroll, fixed;
    padding-top: 10rem;
    padding-bottom: 8rem;
    position: relative;
    overflow: hidden;
  }

  /* Light beam atmospheric backdrop */
  .lightbeam-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    background-image: url('/assets/lightbeam.webp');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    opacity: 0.25;
    mix-blend-mode: screen;
    mask-image: radial-gradient(ellipse 60% 70% at center 35%, black 0%, transparent 80%);
  }

  /* Content inside transition-wrapper sits above the backdrop */
  .transition-wrapper > .mx-auto {
    position: relative;
    z-index: 1;
  }

  /* Terminal */
  .terminal-container {
    background: #1A1816;
    border-radius: 8px;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.12),
      0 0 80px rgba(139, 64, 73, 0.06);
    overflow: hidden;
  }

  .terminal-titlebar {
    height: 36px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
  }

  .traffic-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  .terminal-name {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.2);
  }

  .terminal-body {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 640px) {
    .terminal-body {
      aspect-ratio: unset;
      min-height: 400px;
    }
  }

  .terminal-loading {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: #A89F91;
  }

  /* Cursor blink */
  .cursor-block {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: #A89F91;
    animation: blink 800ms step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Keyboard hints */
  .kbd-hints {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .kbd-sep {
    color: rgba(255, 255, 255, 0.15);
  }

  /* About */
  .about-section {
    padding-top: 6rem;
    padding-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .about-text {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.5);
  }

  .source-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: #8B4049;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: filter 150ms ease;
  }

  .source-link:hover {
    filter: brightness(1.3);
  }

  /* Footer */
  .footer {
    padding-top: 3rem;
    padding-bottom: 2rem;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.2);
  }

  .footer-sep {
    color: rgba(255, 255, 255, 0.1);
  }

  .footer-link {
    color: rgba(255, 255, 255, 0.2);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: rgba(255, 255, 255, 0.4);
  }
</style>
