---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Read Scripture — bible.hulsman.dev",
  description = "A terminal Bible reader in your browser. Three translations, vim navigation, full-text search. Built with Rust and WebAssembly.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F2EB" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>

<style>
  body {
    position: relative;
    animation: fadeIn 800ms ease-out both;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
